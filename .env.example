# App Configuration
VITE_APP_TITLE=Virtual Try-On
VITE_APP_VERSION=0.1.0

# Camera & Performance settings
VITE_CAMERA_WIDTH=1280
VITE_CAMERA_HEIGHT=720
VITE_CAMERA_FPS=30

# MediaPipe Configuration (Local Model Assets)
VITE_MEDIAPIPE_MODEL_PATH=/models/pose_landmarker_lite.task
VITE_MEDIAPIPE_WASM_PATH=/wasm

# Cloud AI Virtual Try-On API Configuration (Genlook Provider)
# IMPORTANT: API Keys should never be committed to git or exposed to the renderer in production.
GENLOOK_API_ENDPOINT=https://api.genlook.ai/v1
GENLOOK_API_KEY=your_genlook_api_key_here
